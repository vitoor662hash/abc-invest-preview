# =================================================================
# ABC Invest — Apache config
# Hostinger compartilhada usa Apache; estes diretivas funcionam direto.
# =================================================================

# -----------------------------------------------------------------
# Forçar HTTPS (descomentar após instalar SSL no painel da Hostinger)
# -----------------------------------------------------------------
# <IfModule mod_rewrite.c>
#     RewriteEngine On
#     RewriteCond %{HTTPS} !=on
#     RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>

# -----------------------------------------------------------------
# Forçar www (ou non-www) — escolher um dos dois e descomentar
# -----------------------------------------------------------------
# Versão non-www → www:
# <IfModule mod_rewrite.c>
#     RewriteEngine On
#     RewriteCond %{HTTP_HOST} ^abcinvest\.com\.br$ [NC]
#     RewriteRule ^(.*)$ https://www.abcinvest.com.br/$1 [L,R=301]
# </IfModule>

# -----------------------------------------------------------------
# Página inicial padrão
# -----------------------------------------------------------------
DirectoryIndex index.html index.php

# -----------------------------------------------------------------
# Headers de segurança
# -----------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS}=='on'"
    # CSP relaxado o suficiente pra Google Fonts. Ajustar quando GA / Pixel forem ligados.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://www.googletagmanager.com 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self' https://www.google-analytics.com; frame-ancestors 'self'"
</IfModule>

# -----------------------------------------------------------------
# Compressão (Gzip)
# -----------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/json application/xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# -----------------------------------------------------------------
# Cache de assets estáticos
# -----------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType application/json "access plus 0 seconds"
    ExpiresByType image/svg+xml "access plus 6 months"
    ExpiresByType image/png "access plus 6 months"
    ExpiresByType image/jpeg "access plus 6 months"
    ExpiresByType image/webp "access plus 6 months"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|svg|png|jpg|jpeg|webp|woff|woff2|ico)$">
        Header set Cache-Control "public, max-age=2592000, immutable"
    </FilesMatch>
    <FilesMatch "\.(html|json)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# -----------------------------------------------------------------
# Bloquear acesso a arquivos sensíveis
# -----------------------------------------------------------------
<FilesMatch "^(\.env|\.htaccess|\.htpasswd|composer\.json|composer\.lock|README\.md|DEPLOY\.md)$">
    Require all denied
</FilesMatch>

<FilesMatch "\.(sql|md|log)$">
    Require all denied
</FilesMatch>

# Bloquear listagem de diretórios
Options -Indexes

# Bloquear acesso direto a /includes/ e /sql/
RedirectMatch 403 ^/includes/?$
RedirectMatch 403 ^/sql/?$
RedirectMatch 403 ^/includes/.*\.php$

# -----------------------------------------------------------------
# Limite de upload pro PHP (não usado hoje, prevenção)
# -----------------------------------------------------------------
<IfModule mod_php.c>
    php_value upload_max_filesize 4M
    php_value post_max_size 4M
</IfModule>

# -----------------------------------------------------------------
# 404 customizado (opcional — descomentar se criar 404.html)
# -----------------------------------------------------------------
# ErrorDocument 404 /404.html
